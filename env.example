# Copy to .env.local and fill in. .env.local is git-ignored; never commit real values.
# Every PayPal value here must come from a SANDBOX app. Never use live credentials.

# Required. PayPal sandbox REST app: developer.paypal.com > Apps & Credentials > Sandbox.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# Required. Channel3 product search API key (free account at https://trychannel3.com). Server-side only.
CHANNEL3_API_KEY=

# Required. Gemini API key for the shopping agent (free at https://aistudio.google.com/apikey). Server-side only.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: AG Studio licence key for /dashboard. Works without one.
AG_STUDIO=

# Optional, leave blank: the AG Studio OpenAI assistant on /dashboard is meant to stay off for
# this project. If set (or if OPENAI_API_KEY is already exported in your shell), it turns on.
AG_STUDIO_OPENAI_API_KEY=
OPENAI_API_KEY=

# Optional: comma-separated OpenAI model ids for that assistant; the first is the default
# (gpt-5.4-mini when blank).
OPENAI_MODELS=
